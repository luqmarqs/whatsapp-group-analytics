# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=wga
POSTGRES_USER=wga
POSTGRES_PASSWORD=change_me_strong_password_here

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password_here

# ─── API ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_jwt_secret_minimum_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# One-time token to create the first admin user (POST /admin/create-first-user)
# Generate with: openssl rand -hex 32
FIRST_ADMIN_TOKEN=change_me_first_admin_token_here

# ─── Worker ───────────────────────────────────────────────────────────────────
# Name for this WhatsApp instance (used in the DB)
INSTANCE_NAME=main

# Set to "true" to store raw message text (increases storage; off by default)
STORE_MESSAGE_BODY=false

# Delay between queued participant resyncs. Keep this >0 to avoid flooding Baileys.
RESYNC_DELAY_MS=1500

# ─── Caddy / Domain ───────────────────────────────────────────────────────────
# Your public domain (Caddy obtains TLS automatically)
DOMAIN=analytics.yourdomain.com

# ─── Docker (gestão de instâncias via painel admin) ───────────────────────────
# Nome da imagem do worker — rode "docker images | grep worker" para confirmar
# Em produção com compose: wga-worker  |  localmente: whatsapp-group-analytics-worker
WORKER_IMAGE=wga-worker

# Nome da rede Docker criada pelo compose
# Em produção: wga_backend  |  localmente: whatsapp-group-analytics_backend
DOCKER_NETWORK=wga_backend
